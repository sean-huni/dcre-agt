<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- SCRUM-70: the launch intent carries its target K8s namespace durably
         (flow namespaces dcre-col/dcre-pay/dcre-man; control namespace dcre),
         so OutcomeWatcher/OrphanRelauncher/Reconciler recreates act on the
         namespace that was INTENDED, never on a config-of-the-day guess.
         Legacy (pre-SCRUM-70) rows deliberately stay NULL: every reader falls
         back to the control namespace via LaunchIntent.namespaceOr, so no
         data backfill is needed. -->
    <changeSet id="007-intent-namespace" author="dcre">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="launch_intent" columnName="namespace"/></not>
        </preConditions>
        <addColumn tableName="launch_intent">
            <column name="namespace" type="VARCHAR(63)"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="launch_intent" columnName="namespace"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
